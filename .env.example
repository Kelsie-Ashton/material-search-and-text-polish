# ===============================================================
# 环境变量模板
#
# 使用方法：复制本文件为 .env 后填写。（.env 已被 .gitignore 忽略）
#
# ⚠️ 重要：推荐直接在应用的「设置」界面填写 API Key。
#    设置界面会把密钥写入 data/credentials.json，该目录同样已被忽略。
#    本文件中的环境变量仅作为「可选的回退方式」，供自动化/高级场景使用。
#
# 🚫 本文件只允许存放占位符。请勿把任何真实密钥写入本文件并提交到仓库。
# ===============================================================

# Anthropic API Key（留空则由设置界面提供）
ANTHROPIC_API_KEY=

# 可选：自定义服务地址（用于代理或兼容网关）
ANTHROPIC_BASE_URL=

# 可选：自定义模型名，留空则使用默认的 claude-opus-5
ANTHROPIC_MODEL=

# 可选：后端监听端口，默认 5174
PORT=
